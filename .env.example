# ==============================================================================
# LUXURY DIGITAL WEDDING INVITATION & RSVP MANAGEMENT SYSTEM
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY SECRETS (Required in all environments)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC-SHA256 secrets for household invitation code digests (supports key rotation)
INVITATION_HMAC_SECRET_CURRENT=luxury-wedding-hmac-secret-v1-change-in-production-9f8e7d6c5b4a3f2e1d
INVITATION_HMAC_SECRET_PREVIOUS=
INVITATION_HMAC_KEY_VERSION=1

# Session signing secrets (minimum 32 characters)
SESSION_SIGNING_SECRET=luxury-wedding-session-signing-secret-2026-change-in-prod-8a7b6c5d4e

# Default local administrator credentials (used for initial seed / local auth fallback)
INITIAL_ADMIN_EMAIL=organizer@luxurywedding.example
INITIAL_ADMIN_PASSWORD=LuxuryWedding!2026

# ------------------------------------------------------------------------------
# 2. STORAGE DRIVER MODE
# "auto" (default) uses Firestore when Firebase Admin credentials or Emulator
# hosts are configured, and falls back to the transactional local file-backed
# database (.data/wedding-db.json) during local development without Java/Cloud.
# Values: "auto" | "firestore" | "local"
# ------------------------------------------------------------------------------
WEDDING_STORAGE_DRIVER=auto

# ------------------------------------------------------------------------------
# 3. FIREBASE EMULATOR SUITE CONFIGURATION (Local Emulator Mode)
# Uncomment when running `firebase emulators:start --project demo-luxury-wedding`
# ------------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=demo-luxury-wedding
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-luxury-wedding
# FIREBASE_STORAGE_BUCKET=demo-luxury-wedding.appspot.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-luxury-wedding.appspot.com
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ------------------------------------------------------------------------------
# 4. PRODUCTION FIREBASE CLOUD CONFIGURATION (Do NOT configure without authorization)
# ------------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE TURNSTILE (Abuse Prevention - Optional in Local Dev)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

